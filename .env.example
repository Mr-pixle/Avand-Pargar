HOST=0.0.0.0
PORT=8082
DATABASE_URL=postgres://avand:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/avand
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
TARAZ_ADMIN_USERNAME=admin
TARAZ_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
